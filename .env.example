# ============================================================================
# Environment variables — copy this file to `.env.local` and fill it in.
#   cp .env.example .env.local
#
# `.env.local` is in .gitignore. NEVER commit real keys.
# ============================================================================


# ---------------------------------------------------------------------------
# OPTIONAL — dynamic age & birthday countdown
# ---------------------------------------------------------------------------
# Your date of birth. Used ONLY on the server to calculate your age and the
# birthday countdown, and it is never sent to the browser.
#
# NOTE: this is deliberately NOT prefixed with NEXT_PUBLIC_. If it were, the
# exact date of birth would end up in the public JavaScript bundle.
#
# Leave it blank to hide the age — the site still builds and renders. Set the
# real value in your hosting provider's environment variables when you deploy
# (e.g. Vercel -> Settings -> Environment Variables).
#
# Format: YYYY-MM-DD  (example: 2010-01-31)
BIRTHDATE=


# ---------------------------------------------------------------------------
# REQUIRED before deploying — canonical site URL
# ---------------------------------------------------------------------------
# No trailing slash. Used for canonical links, Open Graph URLs, sitemap.xml
# and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain-here.com


# ---------------------------------------------------------------------------
# OPTIONAL — public profile links
# ---------------------------------------------------------------------------
# Only link platforms that are public by design. Never link anything that
# exposes an email address or a private account.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username
NEXT_PUBLIC_SCRATCH_URL=https://scratch.mit.edu/users/your-username


# ---------------------------------------------------------------------------
# OPTIONAL — set to "false" while developing so search engines skip the site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_INDEXABLE=true


# ---------------------------------------------------------------------------
# CONTACT FORM — Resend
# ---------------------------------------------------------------------------
# WHY NOT WEB3FORMS: Web3Forms refuses server-side calls on its free plan
# ("Use our API in client side ... Pro plan is required"). Calling it from the
# browser would put the key in client-side JS and bypass this server's rate
# limiting, honeypot and sanitisation. Resend supports server-side sending, so
# every one of those protections stays in place.
#
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Create an API key and paste it below.
# 3. Set CONTACT_TO_EMAIL to the inbox that should receive messages. It MUST be
#    the email the Resend account belongs to, until you verify a domain.
#
# NEVER paste the key into a source file, a commit, or a chat.
# Leaving either value blank disables the form with a friendly notice.
RESEND_API_KEY=

# Where messages are delivered (server-side only, never sent to the browser).
CONTACT_TO_EMAIL=

# OPTIONAL. Defaults to "Portfolio Contact <onboarding@resend.dev>", which
# works without owning a domain but only delivers to the account owner.
CONTACT_FROM_EMAIL=


# ---------------------------------------------------------------------------
# OPTIONAL — Cloudflare Turnstile (free, invisible captcha)
# ---------------------------------------------------------------------------
# Add TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY in the Cloudflare dashboard
# (Widgets -> Turnstile), then set the secret here. When the secret is set,
# the server verifies every submission against Cloudflare and fails CLOSED on
# any error.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=


# ---------------------------------------------------------------------------
# RECOMMENDED FOR PRODUCTION — distributed rate limiting
# ---------------------------------------------------------------------------
# Without these the site falls back to an in-memory limiter, which only works
# on a single server instance. On Vercel/serverless, create a free Upstash
# Redis database and paste both values here.
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt used to hash IP addresses before using them as rate-limit keys.
# Generate a random one, e.g.:  openssl rand -hex 32
RATE_LIMIT_SALT=change-me-to-a-long-random-string